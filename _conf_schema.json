{
  "ignored_plugins": {
    "description": "黑名单插件 ID",
    "hint": "屏蔽不想展示、导致问题的插件菜单 (使用 name 字段)",
    "type": "list",
    "default": [
      "astrbot",
      "astrbot-web-searcher",
      "astrbot-python-interpreter",
      "session_controller",
      "builtin_commands",
      "astrbot-reminder",
      "astrbot_plugin_help_typst"
    ]
  },
  "rendering": {
    "description": "渲染引擎设置",
    "type": "object",
    "items": {
      "timeout_compile": {
        "description": "Typst 编译超时 (秒)",
        "type": "float",
        "slider": {
          "min": 3,
          "max": 60,
          "step": 1
        },
        "default": 30.0,
        "hint": "获得并发名额后计时，包含 Typst 编译和图片转换；超时后停止等待，后台线程完成后自动清理临时文件"
      },
      "max_concurrent_tasks": {
        "description": "最大并发编译数",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        },
        "default": 2,
        "hint": "所有菜单与搜索请求共用的编译线程上限，超出的请求排队等待"
      },
      "ppi": {
        "description": "图片清晰度 (PPI)",
        "type": "float",
        "slider": {
          "min": 64,
          "max": 256,
          "step": 1
        },
        "default": 180.0,
        "hint": "越高图片越清晰，但越慢&大&高占用，根据内存 & 带宽调整"
      },
      "giant_threshold": {
        "description": "巨型块阈值 (pt)",
        "type": "int",
        "slider": {
          "min": 100,
          "max": 3000,
          "step": 100
        },
        "default": 1500,
        "hint": "超过此高度的插件将独占一行显示 (仅 Event/Filter 模式有效)"
      },
      "split_height": {
        "description": "长图切分高度 (px)",
        "type": "int",
        "slider": {
          "min": 1000,
          "max": 16000,
          "step": 1000
        },
        "default": 16000,
        "hint": "当图片高度超过 WebP 限制时的切分单位高度"
      }
    }
  }
}
