{
  "ignored_plugins": {
    "description": "黑名单插件 ID",
    "hint": "屏蔽不想展示、导致问题的插件菜单 (使用 name 字段)",
    "type": "list",
    "default": [
      "astrbot",
      "astrbot-web-searcher",
      "astrbot-python-interpreter",
      "session_controller",
      "builtin_commands",
      "astrbot-reminder",
      "astrbot_plugin_help_typst"
    ]
  },
  "rendering": {
    "description": "渲染引擎设置",
    "type": "object",
    "items": {
      "ppi": {
        "description": "图片清晰度 (PPI)",
        "type": "float",
        "slider": {
          "min": 64,
          "max": 256,
          "step": 1
        },
        "default": 180.0,
        "hint": "越高图片越清晰，但越慢&大&高占用，根据内存 & 带宽调整"
      },
      "giant_threshold": {
        "description": "巨型块阈值 (pt)",
        "type": "int",
        "slider": {
          "min": 100,
          "max": 3000,
          "step": 100
        },
        "default": 1500,
        "hint": "超过此高度的插件将独占一行显示 (仅 Event/Filter 模式有效)"
      }
    }
  }
}
